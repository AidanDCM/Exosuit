{
  "name": "exosuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first MCP computer embodiment runtime with deterministic safety and a Windows agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pulse": "vitest run tests/systemPulse.test.ts",
    "validate:repository": "node scripts/validate-repository.mjs",
    "validate:ci-parity": "node scripts/ci-parity.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "validate:typescript": "npm run validate:repository && npm run typecheck && npm test -- --reporter=verbose && npm run build && npm run test:pulse -- --reporter=verbose",
    "validate": "npm run validate:typescript && npm run agent:test",
    "dev:mcp": "tsx src/index.ts",
    "start:mcp": "node dist/src/index.js",
    "agent:build": "dotnet build apps/windows-agent/Exosuit.Agent.csproj",
    "agent:test": "dotnet test apps/windows-agent.Tests/Exosuit.Agent.Tests.csproj",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "validate:ci-parity:clean": "node scripts/ci-parity.mjs --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  }
}

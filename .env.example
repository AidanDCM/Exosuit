# Copy values into your local environment; do not commit real secrets.
EXOSUIT_AGENT_MODE=fake
EXOSUIT_AGENT_URL=http://127.0.0.1:43117
EXOSUIT_AGENT_TOKEN=replace-with-at-least-32-random-characters
EXOSUIT_GATEWAY_REQUEST_TIMEOUT_MS=20000
EXOSUIT_PROVIDER=fake
EXOSUIT_AGENT_PORT=43117
EXOSUIT_ENABLE_WINDOWS_PROVIDER=
EXOSUIT_ENABLE_PHYSICAL_INPUT=false
EXOSUIT_INITIAL_MODE=
EXOSUIT_FULL_CONTROL_ACK=
EXOSUIT_ENABLE_SCREENSHOTS=false
EXOSUIT_ALLOWED_PROCESSES=notepad,calculator
EXOSUIT_PROVIDER_TIMEOUT_MS=15000
EXOSUIT_EMERGENCY_STOP_TIMEOUT_MS=3000
EXOSUIT_DATA_DIR=
EXOSUIT_GATEWAY_LEDGER=
EXOSUIT_APPLICATION_MAP_DIR=

# Physical input is intentionally impossible unless all of these are set locally before process startup:
# EXOSUIT_PROVIDER=windows
# EXOSUIT_ENABLE_WINDOWS_PROVIDER=I_UNDERSTAND_WINDOWS_UI_AUTOMATION_RISK
# EXOSUIT_ENABLE_PHYSICAL_INPUT=true
# EXOSUIT_INITIAL_MODE=full_control
# EXOSUIT_FULL_CONTROL_ACK=I_UNDERSTAND_RAW_INPUT_CAN_CONTROL_THIS_DESKTOP
# EXOSUIT_ALLOWED_PROCESSES=notepad,calculator
